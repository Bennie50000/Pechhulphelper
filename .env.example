# Kopieer dit bestand naar ".env" en vul je gegevens in
# NOOIT je .env bestand delen of op GitHub zetten!

DISCORD_TOKEN=jouw_bot_token_hier
CLIENT_ID=jouw_application_id_hier

# Optioneel: rol-ID's die ALTIJD staff-toegang hebben tot bot-configuratiecommands,
# los van Discord's Administrator-permissie en zonder /addstaffrole nodig te hebben.
# Komma-gescheiden als je er meerdere wilt, bv: STAFF_ROLE_IDS=123456789,987654321
STAFF_ROLE_IDS=

# Voor de "Inactiviteit"-knop in /actiepaneel: welk kanaal en welke rol altijd gebruikt
# worden, ongeacht in welk kanaal je op de knop klikt.
INACTIVITY_CHANNEL_ID=
INACTIVITY_ROLE_ID=1282368421786419243

# Voor de "Basistraining reminder"-knop in /actiepaneel: welke rol getagd wordt en in welk
# kanaal het bericht komt (incl. de link naar dat kanaal in het bericht zelf). Alleen het
# aantal minuten vul je zelf in via een kort formuliertje na het klikken op de knop.
BASISTRAINING_ROLE_ID=881971018279813121
BASISTRAINING_CHANNEL_ID=1485057076446232616

# Voor de "Plan gesprek"-knop: welke rol getagd wordt als "kandidaat" (in plaats van een
# losse gebruiker te kiezen — de hele sollicitanten-rol wordt getagd).
SOLLICITANT_ROLE_ID=

# Optioneel: jouw eigen Discord user-ID. Alleen jij kan dan /grantadmin gebruiken (geeft
# een rol Administrator-rechten). Leeg laten = niemand kan het gebruiken.
OWNER_ID=

# Optioneel: rol die iemand automatisch krijgt als diegene het telspel verpest ("Kan niet tellen").
KAN_NIET_TELLEN_ROLE_ID=

# Kanaal dat gelinkt wordt in het "Afgelast"-bericht (waar mensen updates kunnen volgen).
MEDEDELINGEN_CHANNEL_ID=

# Voicekanaal (wachtkamer) dat onderaan het "Plan gesprek"-bericht gelinkt wordt.
WACHTKAMER_CHANNEL_ID=

